generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Presente {
  id         Int       @id @default(autoincrement())
  nome       String
  categoria  String
  reservado  Boolean   @default(false)

  reserva    Reserva?

  createdAt  DateTime  @default(now())
}

model Reserva {
  id          Int      @id @default(autoincrement())
  nomePessoa  String
  telefone    String?

  presenteId  Int      @unique
  presente    Presente @relation(fields: [presenteId], references: [id])

  createdAt   DateTime @default(now())
}