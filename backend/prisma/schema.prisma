generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Presente {
  id        Int      @id @default(autoincrement())
  nome      String
  categoria String
  reservado Boolean  @default(false)
  createdAt DateTime @default(now())
  reserva   Reserva?
}

model Reserva {
  id         Int      @id @default(autoincrement())
  nomePessoa String
  telefone   String?
  presenteId Int      @unique
  createdAt  DateTime @default(now())
  presente   Presente @relation(fields: [presenteId], references: [id])
}
